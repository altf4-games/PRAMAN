# PRAMAN — environment template. Copy to .env and fill in.
# NEVER commit .env. Razorpay TEST MODE keys only — never live keys, ever.

DEMO_MODE=true

# --- Razorpay (test mode only, key_id starts with rzp_test_) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=changeme
RAZORPAY_WEBHOOK_SECRET=changeme
RAZORPAY_USE_FAKE=false

# --- Database / cache (Phase 1+) ---
DATABASE_URL=postgresql+asyncpg://praman:praman@localhost:5432/praman
REDIS_URL=redis://localhost:6379/0

# --- Twilio WhatsApp sandbox (Phase 3+) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_USE_FAKE=false
# Must match the exact public URL Twilio is configured to POST the webhook to
# (used to reconstruct the signed URL for signature verification behind a proxy).
PUBLIC_BASE_URL=http://localhost:8000

# --- Telegram (added post-Phase-7 — see ARCHITECTURE.md's "Post-Phase-7"
# section; a real, confirmed Twilio Trial-tier restriction blocks fetching
# inbound media via the REST API at all, with no code-level workaround.
# Telegram has no equivalent approval gate: create a bot via @BotFather,
# set TELEGRAM_WEBHOOK_SECRET to any random string, and register the
# webhook with `https://api.telegram.org/bot<TOKEN>/setWebhook?url=<PUBLIC_BASE_URL>/tg/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>`.) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_FAKE=false

# --- LLM (Phase 2+, catalog extraction / substitution ranking only) ---
# LLM_PROVIDER selects the adapters/llm.py implementation: gemini | openai | anthropic | fake
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
